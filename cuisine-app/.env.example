# Comptes et synchronisation (Supabase). Valeurs PUBLIQUES (URL du projet et clé « publishable » / anon).
# Copiez ce fichier en .env.local pour les utiliser au lieu des valeurs par défaut de src/cloud/config.ts.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Options facultatives (désactivées par défaut, voir docs/SUPABASE.md §6).
# Aucun secret ici : la clé Anthropic et le secret Strava restent dans les fonctions serveur.
VITE_FEATURE_AI=0
VITE_FEATURE_STRAVA=0
VITE_STRAVA_CLIENT_ID=
VITE_FEATURE_GOOGLE=0
